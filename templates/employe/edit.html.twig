{% extends 'base.html.twig' %}

{% block title %}{{ employe.prenom ~ ' ' ~ employe.nom }}{% endblock %}
{% block page_title %}{{ employe.prenom ~ ' ' ~ employe.nom }}{% endblock %}

{% block page_content %}
    {{ form_start(form) }}
    {{ form_row(form.nom, {label : 'Nom'}) }}
    {{ form_row(form.prenom, {label : 'Prenom'}) }}
    {{ form_row(form.adresseEmail, {label : 'Email'}) }}
    <div class="form-flex">
        {{ form_row(form.dateEntree, {label : "Date d'entrée"}) }}
        {{ form_row(form.typeContrat, {label : 'Statut'}) }}
    </div>
    <button class="button button-submit">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}

