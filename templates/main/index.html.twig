{% extends 'base.html.twig' %}

{% block title %}Liste des projets {% endblock %}
{% block page_title %}Projets{% endblock %}

{% block page_content %}
    <div id="projects-container">
        {% for projet in projets %}
            <article class="card-project">
                <a href="{{ path('app_projet_show', {'id' : projet.id}) }}">
                    <h2>{{ projet.nom }}</h2>
                </a>
                <div class="card-project-icons">
                    <a href="{{ path('app_projet_edit', {'id' : projet.id}) }}"><i class="fa-solid fa-pen"></i></a>
                    <a href="#" data-controller="delete" class="delete-projet-{{ projet.id }}" data-action="click->delete#delete" data-target="#delete-projet-form-{{ projet.id }}-id"><i class="fa-solid fa-trash"></i></a>
                </div>
                <form method="post" id="delete-projet-form-{{ projet.id }}-id" action="{{ path('app_projet_delete', {id: projet.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-projet-' ~ projet.id) }}">
                </form>
            </article>
        {% endfor %}
        <article class="card-project">
            <a href="projet-add.html">
                <i class="fa-solid fa-circle-plus add-project-icon"></i>
                <h2>Ajouter un projet</h2>
            </a>
        </article>
    </div>
{% endblock %}


