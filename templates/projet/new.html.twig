{% extends 'base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}
{% block page_title %}Nouveau projet{% endblock %}

{% block page_content %}
    {{ form_start(form) }}
    {{ form_row(form.nom, {label : 'Titre du projet'}) }}
    {{ form_row(form.employes, {label : 'Inviter des membres'}) }}
    <br>
    <button class="button button-submit">Continuer</button>
    {{ form_end(form) }}
{% endblock %}