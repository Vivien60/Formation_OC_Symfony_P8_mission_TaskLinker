{% extends 'sign.html.twig' %}

{% block title %}S'inscrire{% endblock %}

{% block page_content %}
    <h1>S'inscrire</h1>

    <div class="signup">
        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}
            <div class="form-group--signup">
                {{ form_row(registrationForm.nom) }}
                {{ form_row(registrationForm.prenom) }}
                {{ form_row(registrationForm.adresseEmail) }}
                {{ form_row(registrationForm.plainPassword, {
                    label: 'Mot de passe'
                }) }}
                {{ form_widget(registrationForm._token) }}
            </div>
            <button type="submit" class="button button-submit button--signup-submit">Continuer</button>
        {{ form_end(registrationForm, {render_rest: false}) }}
    </div>
{% endblock %}
